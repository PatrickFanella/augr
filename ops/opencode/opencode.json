{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "model": "openai/gpt-5.4-mini",
  "small_model": "openai/gpt-5.4-mini",
  "default_agent": "augr-fallback",
  "permission": {
    "*": "deny"
  },
  "agent": {
    "augr-fallback": {
      "description": "Tool-free completion backend for Augr fallback requests",
      "mode": "primary",
      "steps": 1,
      "permission": {
        "*": "deny"
      }
    }
  }
}
