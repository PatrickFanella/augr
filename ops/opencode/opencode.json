{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.6-luna",
  "default_agent": "augr-completion",
  "permission": {
    "*": "deny"
  },
  "agent": {
    "augr-completion": {
      "description": "Tool-free completion backend for Augr model requests",
      "mode": "primary",
      "steps": 1,
      "permission": {
        "*": "deny"
      }
    }
  }
}
